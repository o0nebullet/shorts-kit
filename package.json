    "normalize": "bun scripts/normalize.ts",
    "encode": "bun scripts/encode.ts",
    "preview": "bun scripts/preview.ts",
    "satellite": "bun scripts/satellite.ts",
    "capture": "bun scripts/capture.ts",
    "beats": "bun scripts/beats.ts",
