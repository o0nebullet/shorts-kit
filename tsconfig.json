{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["bun", "react"],
    "paths": {
      "@kn/*": ["./scripts/preview/kn/*"]
    }
  },
  "include": ["src", "scripts", "remotion.config.ts"],
  "exclude": ["src/demo"]
}
